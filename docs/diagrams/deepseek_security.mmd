---
title: DeepSeek 安全接入流程图
---
%% 图示说明：展示 Fake 默认离线边界与 DeepSeek 人工显式接入、.env 隔离和日志脱敏流程。
%%{init: {"theme":"base","flowchart":{"curve":"basis","nodeSpacing":30,"rankSpacing":36},"themeVariables":{"fontFamily":"Microsoft YaHei, Noto Sans CJK SC, sans-serif","fontSize":"16px","lineColor":"#64748B"}}}%%
flowchart LR
    SELECT{"选择 backend"}

    subgraph OFFLINE["默认离线路径"]
        direction TB
        FAKE["fake<br/>默认后端"]
        TEST["pytest<br/>Mock / Fake"]
        BASE["基础 Benchmark<br/>300条"]
        EVIDENCE["证据实验<br/>Context / Memory"]
        BLOCK["不读取 DeepSeek 凭据<br/>不访问真实接口"]
        FAKE --> TEST
        FAKE --> BASE
        FAKE --> EVIDENCE
        TEST --> BLOCK
        BASE --> BLOCK
        EVIDENCE --> BLOCK
    end

    subgraph REAL["人工真实演示路径"]
        direction TB
        ENV["本地 .env<br/>保存 API Key"]
        SETTINGS["Settings<br/>读取 MEMLINK_*"]
        CHECK{"配置完整？"}
        CLIENT["DeepSeek Client<br/>超时 · 有限重试"]
        HTTPS["HTTPS<br/>Chat Completions"]
        API["DeepSeek API"]
        DEMO["run-demo / API / UI<br/>显式选择 deepseek"]
        SAFE_FAIL["脱敏失败<br/>不回退 Fake"]
        ENV --> SETTINGS --> CHECK
        CHECK -->|"是"| CLIENT --> HTTPS --> API --> DEMO
        CHECK -->|"否"| SAFE_FAIL
    end

    subgraph PROTECT["保护措施"]
        direction TB
        IGNORE[".gitignore 忽略 .env<br/>不提交仓库"]
        REDACT["日志 / 页面<br/>仅显示已配置 / 未配置"]
        NO_SECRET["不写入源码 · 测试 · 截图<br/>不记录 Key / Authorization"]
        NO_PAID["不纳入自动化测试<br/>不运行大规模付费 Benchmark"]
    end

    SELECT -->|"默认"| FAKE
    SELECT -->|"人工显式启用"| SETTINGS
    ENV --> IGNORE
    SETTINGS --> REDACT
    CLIENT --> NO_SECRET
    DEMO --> NO_PAID
    SAFE_FAIL --> REDACT

    classDef choice fill:#FFFFFF,stroke:#64748B,color:#1E293B,stroke-width:1.5px;
    classDef offline fill:#EAF3FF,stroke:#377DFF,color:#16325C,stroke-width:1.4px;
    classDef real fill:#ECFDF3,stroke:#22A06B,color:#124B35,stroke-width:1.4px;
    classDef secret fill:#FFF4E5,stroke:#F59E0B,color:#5C3A00,stroke-width:1.5px;
    classDef protect fill:#F2ECFF,stroke:#7C4DFF,color:#35205F,stroke-width:1.4px;
    classDef failure fill:#FFF8E8,stroke:#E6A700,color:#594100,stroke-width:1.4px;

    class SELECT,CHECK choice;
    class FAKE,TEST,BASE,EVIDENCE,BLOCK offline;
    class SETTINGS,CLIENT,HTTPS,API,DEMO real;
    class ENV secret;
    class IGNORE,REDACT,NO_SECRET,NO_PAID protect;
    class SAFE_FAIL failure;
