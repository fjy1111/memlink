---
title: 共享记忆复用闭环图
---
%% 图示说明：展示 SQLite 记忆检索、证据复用、整体审核、写回闭环及复用正确性评价。
%%{init: {"theme":"base","flowchart":{"curve":"basis","nodeSpacing":24,"rankSpacing":30},"themeVariables":{"fontFamily":"Microsoft YaHei, Noto Sans CJK SC, sans-serif","fontSize":"16px","lineColor":"#64748B"}}}%%
flowchart TB
    CONDITIONS["证据实验四种条件<br/>no_memory：禁用记忆　｜　cold_memory：空库<br/>warm_memory：相关前置任务　｜　irrelevant_memory：无关前置任务"]

    subgraph LOOP["检索、复用与写回"]
        direction LR
        TASK["新任务"]
        SQLITE[("SQLite<br/>Shared Memory")]
        RETRIEVED["检索候选<br/>retrieved_memory_ids<br/>并更新 usage_count"]
        FILTER["Retriever 筛选<br/>memory evidence"]
        REUSED["进入证据链<br/>reused_memory_ids"]
        ACT["Executor 使用<br/>Reviewer 整体审核"]
        WRITE["成功经验写回<br/>后续任务再检索"]
        TASK --> SQLITE --> RETRIEVED --> FILTER --> REUSED --> ACT --> WRITE
        WRITE --> SQLITE
    end

    TRUTH["真值与负对照<br/>expected_memory_ids · irrelevant_memory_ids"]
    QUALITY["复用正确性<br/>relevant_memory_reused · irrelevant_memory_reused<br/>memory_reuse_precision"]
    WARNING["解释边界<br/>memory_hit_count 只表示检索命中<br/>不等于正确复用"]

    CONDITIONS --> TASK
    RETRIEVED --> QUALITY
    REUSED --> QUALITY
    TRUTH --> QUALITY --> WARNING

    classDef condition fill:#EAF3FF,stroke:#377DFF,color:#16325C,stroke-width:1.4px;
    classDef memory fill:#E8FAF8,stroke:#0F9D8A,color:#154A43,stroke-width:1.4px;
    classDef pipeline fill:#ECFDF3,stroke:#22A06B,color:#124B35,stroke-width:1.4px;
    classDef agent fill:#FFF4E5,stroke:#F59E0B,color:#5C3A00,stroke-width:1.4px;
    classDef metric fill:#EEF2FF,stroke:#6366F1,color:#24265F,stroke-width:1.4px;
    classDef warning fill:#FFF8E8,stroke:#E6A700,color:#594100,stroke-width:1.4px;

    class CONDITIONS condition;
    class SQLITE,WRITE memory;
    class TASK,RETRIEVED,FILTER,REUSED pipeline;
    class ACT agent;
    class TRUTH,QUALITY metric;
    class WARNING warning;
