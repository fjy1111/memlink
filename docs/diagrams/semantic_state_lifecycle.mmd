---
title: SemanticState 生命周期图
---
%% 图示说明：展示 NumPy 状态的生成、二进制保存、state_id 引用、按需恢复、分离计量和清理。
%%{init: {"theme":"base","flowchart":{"curve":"basis","nodeSpacing":28,"rankSpacing":30},"themeVariables":{"fontFamily":"Microsoft YaHei, Noto Sans CJK SC, sans-serif","fontSize":"17px","lineColor":"#64748B"}}}%%
flowchart TB
    subgraph CREATE_ROW["① 生成与保存"]
        direction LR
        CREATE["EmbeddingClient<br/>生成中间状态"]
        VECTOR["一维 NumPy<br/>浮点向量"]
        VALIDATE["StateStore 校验<br/>维度 · dtype"]
        PERSIST["二进制保存<br/>.npy + .json 元数据"]
        ID["分配 state_id"]
        CREATE --> VECTOR --> VALIDATE --> PERSIST --> ID
    end

    subgraph USE_ROW["② 引用与使用"]
        direction LR
        MESSAGE["AgentMessage<br/>只携带 state_id"]
        RECEIVE["下游消息<br/>接收状态引用"]
        LOAD["运行时按需<br/>StateStore.load"]
        USE["恢复 NumPy 状态<br/>相似度检索"]
        MESSAGE --> RECEIVE --> LOAD --> USE
    end

    subgraph END_ROW["③ 分离计量与生命周期"]
        direction LR
        BINARY["semantic_state_binary_bytes<br/>向量原始二进制"]
        REFERENCE["state_reference_bytes<br/>state_id UTF-8"]
        DISTINCT["两种字节<br/>不可混用"]
        TEMP["隔离实验<br/>临时目录自动清理"]
        NORMAL["普通运行<br/>保留至安全清理"]
        BINARY --> DISTINCT
        REFERENCE --> DISTINCT
        DISTINCT --> TEMP
        DISTINCT --> NORMAL
    end

    ID --> MESSAGE
    VECTOR -. "原始 nbytes" .-> BINARY
    MESSAGE -. "引用字符串" .-> REFERENCE

    classDef process fill:#EAF3FF,stroke:#377DFF,color:#16325C,stroke-width:1.4px;
    classDef storage fill:#E8FAF8,stroke:#0F9D8A,color:#154A43,stroke-width:1.4px;
    classDef protocol fill:#ECFDF3,stroke:#22A06B,color:#124B35,stroke-width:1.4px;
    classDef metric fill:#EEF2FF,stroke:#6366F1,color:#24265F,stroke-width:1.4px;
    classDef boundary fill:#FFF8E8,stroke:#E6A700,color:#594100,stroke-width:1.4px;

    class CREATE,VECTOR,RECEIVE,USE process;
    class PERSIST,LOAD storage;
    class ID,MESSAGE protocol;
    class BINARY,REFERENCE,DISTINCT metric;
    class VALIDATE,TEMP,NORMAL boundary;
