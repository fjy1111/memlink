---
title: MemLink 双通信模式对比图
---
%% 图示说明：客观对照 text 完整文本基线与 structured 机制，并引出上下文增长证据实验。
%%{init: {"theme":"base","flowchart":{"curve":"basis","nodeSpacing":26,"rankSpacing":30},"themeVariables":{"fontFamily":"Microsoft YaHei, Noto Sans CJK SC, sans-serif","fontSize":"17px","lineColor":"#64748B"}}}%%
flowchart TB
    subgraph MODES["双模式客观对比"]
        direction LR
        subgraph TEXT_MODE["text｜基线"]
            direction LR
            T_FLOW["四 Agent<br/>顺序协作"]
            T_HANDOFF["完整自然语言<br/>逐级传递"]
            T_COST["上下文增长<br/>可能重复载荷"]
            T_USE["无 result_ref / state_id<br/>简单公平基线"]
            T_FLOW --> T_HANDOFF --> T_COST --> T_USE
        end

        subgraph STRUCT_MODE["structured｜机制组"]
            direction LR
            S_FLOW["四 Agent<br/>顺序协作"]
            S_SCHEMA["schema 消息<br/>固定协议开销"]
            S_MECHANISM["result_ref · state_id<br/>Shared Memory"]
            S_USE["MessagePack 体积统计<br/>长上下文 / 连续任务 / 消融"]
            S_FLOW --> S_SCHEMA --> S_MECHANISM --> S_USE
        end
    end

    subgraph EVIDENCE["上下文增长证据实验"]
        direction LR
        SCALE["规模<br/>1x · 2x · 4x · 8x"]
        MATRIX["实验组<br/>text · structured<br/>structured_no_result_ref"]
        OBSERVE["指标<br/>UTF-8 · JSON / MessagePack<br/>重复字节 · 耗时"]
        HONEST["边界<br/>不宣称 structured<br/>一定更快"]
        SCALE --> MATRIX --> OBSERVE --> HONEST
    end

    T_USE --> SCALE
    S_USE --> SCALE

    classDef text fill:#EAF3FF,stroke:#377DFF,color:#16325C,stroke-width:1.5px;
    classDef structured fill:#ECFDF3,stroke:#22A06B,color:#124B35,stroke-width:1.5px;
    classDef evidence fill:#EEF2FF,stroke:#6366F1,color:#24265F,stroke-width:1.4px;
    classDef boundary fill:#FFF8E8,stroke:#E6A700,color:#594100,stroke-width:1.5px;

    class T_FLOW,T_HANDOFF,T_COST,T_USE text;
    class S_FLOW,S_SCHEMA,S_MECHANISM,S_USE structured;
    class SCALE,MATRIX,OBSERVE evidence;
    class HONEST boundary;
    style TEXT_MODE fill:#F8FBFF,stroke:#8FB7F2,stroke-width:1.5px;
    style STRUCT_MODE fill:#F6FFFA,stroke:#72CDA5,stroke-width:1.5px;
