# Copy this file to .env and adjust values as needed.
MEMLINK_APP_NAME=MemLink
MEMLINK_APP_VERSION=0.1.0
MEMLINK_ENVIRONMENT=development
MEMLINK_LOG_LEVEL=INFO
MEMLINK_METRICS_DIR=data/metrics
MEMLINK_STATE_DIR=data/states
MEMLINK_MEMORY_DB_PATH=data/memory/memlink.db
MEMLINK_ENABLE_SHARED_MEMORY=true
MEMLINK_ENABLE_SEMANTIC_STATE=true
MEMLINK_ENABLE_RESULT_REFERENCE=true

# Offline by default. DeepSeek is only for manual real-model demonstrations.
MEMLINK_LLM_BACKEND=fake
MEMLINK_DEEPSEEK_API_KEY=replace-me
MEMLINK_DEEPSEEK_BASE_URL=replace-with-deepseek-base-url
MEMLINK_DEEPSEEK_MODEL=replace-with-model-name
MEMLINK_LLM_TIMEOUT_SECONDS=60
MEMLINK_LLM_MAX_RETRIES=2
MEMLINK_LLM_TEMPERATURE=0.2
MEMLINK_LLM_MAX_TOKENS=1500

MEMLINK_EMBEDDING_BACKEND=fake
MEMLINK_EMBEDDING_API_KEY=
MEMLINK_EMBEDDING_BASE_URL=
MEMLINK_EMBEDDING_MODEL=
MEMLINK_EMBEDDING_DIMENSIONS=32
MEMLINK_EMBEDDING_TIMEOUT_SECONDS=60
MEMLINK_EMBEDDING_MAX_RETRIES=2
